  "components": {
    "schemas": {
      "ApiError": {
        "type": "object",
        "description": "The one error body every endpoint returns; `message` and each field error are catalog keys.",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "fields": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/FieldError"
            },
            "propertyNames": {
              "type": "string"
            }
          },
          "message": {
            "type": "string"
          }
        }
      },
      "Business": {
        "type": "object",
        "properties": {
          "address": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "small_business": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "tax_number": {
            "type": [
              "string",
              "null"
            ]
          },
          "vat_id": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      },
      "BusinessView": {
        "type": "object",
        "required": [
          "values",
          "pinned"
        ],
        "properties": {
          "pinned": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Keys fixed by the config; the app shows them read-only."
          },
          "values": {
            "$ref": "#/components/schemas/Business"
          }
        }
      },
      "Challenge": {
        "type": "object",
        "description": "A started WebAuthn ceremony: pass `options` to the browser and send `ceremony` back with its\nresult.",
        "required": [
          "ceremony",
          "options"
        ],
        "properties": {
          "ceremony": {
            "type": "string"
          },
          "options": {
            "type": "object",
            "additionalProperties": {},
            "propertyNames": {
              "type": "string"
            }
          }
        }
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "not_found",
          "malformed_request",
          "invalid_input",
          "unauthenticated",
          "forbidden",
          "csrf_token",
          "setup_done",
          "invalid_setup_token",
          "ceremony_expired",
          "passkey_rejected",
          "last_passkey",
          "last_owner",
          "invitation_invalid",
          "oidc_failed",
          "oidc_unknown_identity",
          "oidc_identity_taken",
          "internal"
        ]
      },
      "FieldError": {
        "type": "string",
        "enum": [
          "required",
          "too_long",
          "invalid_format",
          "pinned"
        ]
      },
      "Health": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string"
          }
        }
      },
      "InvitationInfo": {
        "type": "object",
        "required": [
          "name",
          "role"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          }
        }
      },
      "InvitationRequest": {
        "type": "object",
        "required": [
          "name",
          "role"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          }
        }
      },
      "InvitationToken": {
        "type": "object",
        "required": [
          "token"
        ],
        "properties": {
          "token": {
            "type": "string"
          }
        }
      },
      "InvitationView": {
        "type": "object",
        "required": [
          "id",
          "name",
          "role",
          "created_at",
          "expires_at"
        ],
        "properties": {
          "created_at": {
            "type": "integer",
            "format": "int64"
          },
          "expires_at": {
            "type": "integer",
            "format": "int64"
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          }
        }
      },
      "NewInvitation": {
        "type": "object",
        "required": [
          "invitation",
          "link"
        ],
        "properties": {
          "invitation": {
            "$ref": "#/components/schemas/InvitationView"
          },
          "link": {
            "type": "string",
            "description": "The one-time link to hand to the invitee; it is not shown again."
          }
        }
      },
      "OidcRedirect": {
        "type": "object",
        "required": [
          "url"
        ],
        "properties": {
          "url": {
            "type": "string",
            "description": "Send the browser here."
          }
        }
      },
      "OidcStart": {
        "type": "object",
        "properties": {
          "invitation": {
            "type": [
              "string",
              "null"
            ],
            "description": "Set when an invitee signs up through the identity provider."
          }
        }
      },
      "PasskeyView": {
        "type": "object",
        "required": [
          "id",
          "name",
          "created_at"
        ],
        "properties": {
          "created_at": {
            "type": "integer",
            "format": "int64"
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "last_used_at": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "RegistrationFinish": {
        "type": "object",
        "required": [
          "ceremony",
          "passkey_name",
          "credential"
        ],
        "properties": {
          "ceremony": {
            "type": "string"
          },
          "credential": {
            "type": "object",
            "additionalProperties": {},
            "propertyNames": {
              "type": "string"
            }
          },
          "passkey_name": {
            "type": "string",
            "description": "Shown in the user's list of passkeys."
          }
        }
      },
      "Role": {
        "type": "string",
        "enum": [
          "owner",
          "staff",
          "accountant"
        ]
      },
      "SessionView": {
        "type": "object",
        "required": [
          "setup_required"
        ],
        "properties": {
          "csrf_token": {
            "type": [
              "string",
              "null"
            ],
            "description": "Send as `x-csrf-token` with every state-changing request."
          },
          "oidc": {
            "type": [
              "string",
              "null"
            ],
            "description": "Label of the identity provider's sign-in button, if one is configured."
          },
          "setup_required": {
            "type": "boolean"
          },
          "user": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/User"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "SetupStart": {
        "type": "object",
        "required": [
          "token",
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "token": {
            "type": "string",
            "description": "The token the server printed when it started without users."
          }
        }
      },
      "SignInFinish": {
        "type": "object",
        "required": [
          "ceremony",
          "credential"
        ],
        "properties": {
